# Configuração com credenciais e app_key — nunca versionar
config.php

# Dados de execução — as pastas são versionadas vazias, o conteúdo não
storage/apps/*
storage/.installed
!storage/.htaccess
!storage/apps/.gitkeep

# Ferramentas locais
.claude-flow/
.claude/

# A plataforma nao usa Node. Se alguem correr um npm install aqui por
# engano, o node_modules nao pode entrar no repositorio -- o deploy do
# cPanel copia tudo o que estiver na pasta para o servidor.
node_modules/
package.json
package-lock.json

# Sistema
.DS_Store
Thumbs.db

# Atalhos do ambiente local de demonstracao (nao pertencem a aplicacao)
dev-local.bat
codigo-mfa.bat
