# O protótipo original só é servido através de index.php (com sessão validada).
# Bloquear aqui evita que o HTML fique acessível publicamente por URL direto.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
